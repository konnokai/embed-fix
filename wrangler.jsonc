{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "naver-cafe-embed-fix",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-22",
	"observability": {
		"enabled": true
	},
	// 每小時對各平台的固定公開樣本跑一次健康檢查（src/core/health.ts）。
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "naver-cafe-embed-fix",
			"database_id": "9c0f9e6c-74d3-415e-9294-f1a1665874a0",
			"migrations_dir": "migrations"
		}
	]
}